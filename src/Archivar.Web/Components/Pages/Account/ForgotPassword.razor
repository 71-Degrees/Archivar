@page "/account/forgot"

<PageTitle>Forgot your password - Archivar</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="app-card app-card-narrow">
    <h1 class="app-center">Forgot your password?</h1>

    @if (CodeError is not null)
    {
        <p class="app-error app-small">@AccountMessages.ForCodeError(CodeError)</p>
    }

    @if (Step == "code")
    {
        @if (PasswordError is not null)
        {
            <p class="app-error app-small">@AccountMessages.ForPasswordError(PasswordError)</p>
        }

        <form method="post" action="account/reset-submit" data-enhance-nav="false">
            <AntiforgeryToken />
            <input type="hidden" name="email" value="@Email" />
            <p class="app-small">If an account uses <strong>@Email</strong>, we've sent it a 6-digit code. Enter it with a new password.</p>
            @if (!string.IsNullOrEmpty(DevCode))
            {
                <p class="app-note">Development only - email is not sent, so the code is <strong>@DevCode</strong>.</p>
            }
            <label class="app-field" for="reset-code">Code</label>
            <input id="reset-code" class="app-input" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder="123456" />
            <label class="app-field" for="reset-password">New password</label>
            <input id="reset-password" class="app-input" type="password" name="password" required minlength="8" autocomplete="new-password" />
            <label class="app-field" for="reset-confirm">Confirm new password</label>
            <input id="reset-confirm" class="app-input" type="password" name="confirmPassword" required autocomplete="new-password" />
            <button type="submit" class="app-btn app-btn-block">Set new password</button>
        </form>
    }
    else
    {
        <p class="app-muted app-small">Enter your email and we'll send a 6-digit code. It works for 10 minutes.</p>
        <form method="post" action="account/reset-send" data-enhance-nav="false">
            <AntiforgeryToken />
            <label class="app-field" for="forgot-email">Email</label>
            <input id="forgot-email" class="app-input" type="email" name="email" required autocomplete="email" value="@Email" />
            <button type="submit" class="app-btn app-btn-block">Email me a code</button>
        </form>
    }

    <p class="app-small app-center"><a href="account/login">Back to sign in</a></p>
</div>

@code {
    /// <summary>"code" once a code has been sent and the code and password boxes should show.</summary>
    [SupplyParameterFromQuery]
    private string? Step { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? CodeError { get; set; }

    [SupplyParameterFromQuery]
    private string? PasswordError { get; set; }

    /// <summary>Local development only: the endpoint puts the code here when email isn't being sent.</summary>
    [SupplyParameterFromQuery]
    private string? DevCode { get; set; }
}
