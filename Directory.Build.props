<!-- Solution-wide settings, so no .csproj repeats them. See C:\71Degrees\repos\dotnet-new-project-standards.md (sections 1 and 5). -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Nullable warnings are real bugs waiting to happen - fail the build on them rather than let them pile up. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <!-- The .NET code-quality analyzers at Recommended level in every build (rules that do not fit are switched off, with reasons, in .editorconfig). Zero findings is the standard, so a new one fails the build
         instead of piling up; the Refactor tool in tools/CodeQuality applies the mechanical fixes. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- NuGet Audit runs on every restore; `all` extends it to transitive packages, and the NU190x codes turn a newly
         disclosed vulnerability into a build failure instead of a warning that has to be noticed. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Locks every restore to the exact transitive versions in each project's committed packages.lock.json. CI restores in
         locked mode, so a version change not reflected in the lock file fails the build instead of resolving silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
