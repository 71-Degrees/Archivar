<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher for the shared deploy tool (tools/WebCore). What differs for this app is deploy/deploy.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Archivar.Tools.Deploy</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebCore\src\WebCore.Deploy\WebCore.Deploy.csproj" />
  </ItemGroup>

</Project>
